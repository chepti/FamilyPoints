# הגדרות לתיקיית /family בשרת Apache/LiteSpeed (Hostinger)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# קבצי קוד תמיד נבדקים מחדש מול השרת (ETag/304, זול), כדי שעדכונים יגיעו מיד.
# בלי זה Hostinger מוסיף max-age של שבוע, וה-CDN והדפדפנים מגישים גרסה ישנה.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# קבצים שלא שייכים לאתר
<FilesMatch "^(DEPLOY\.md|CLAUDE\.md|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
